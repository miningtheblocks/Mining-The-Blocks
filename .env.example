# MTB — variables de entorno
# Copiar este archivo a .env.local y rellenar valores reales.
# NUNCA commitear .env, .env.local ni .env.*.local (gitignored).

# ===========================================
# Cliente (RN/Expo) — EXPO_PUBLIC_* se inyectan en runtime
# ===========================================

# Sentry DSN (cliente). Obtener desde Sentry → Project Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Setear "1" para forzar test de Sentry al boot. Dejar vacío en producción.
EXPO_PUBLIC_SENTRY_TEST=

# Sentry CLI auth token — necesario para upload de source maps en build (no
# en runtime). Round 2 audit #9 HIGH-2. Obtener en https://sentry.io/settings/
# account/api/auth-tokens/ con scopes: project:releases, project:write, org:read.
# NUNCA en runtime — solo para CI / EAS build pipeline. Configurar como EAS secret:
#   eas secret:create --scope project --name SENTRY_AUTH_TOKEN --value "sntrys_..."
SENTRY_AUTH_TOKEN=

# ===========================================
# Build / firma Android (CI o local release)
# ===========================================

# Strip console.* en producción. eas.json ya lo setea para profile=production.
STRIP_CONSOLE=1

# Path absoluto al keystore. Fuera del repo (recomendado: ~/.mtb-keys/...).
MTB_KEYSTORE_PATH=/path/to/your/mtb-release-v2.keystore

# Passwords del keystore (NUNCA commitear).
MTB_STORE_PASSWORD=
MTB_KEY_ALIAS=mtb-release
MTB_KEY_PASSWORD=

# ===========================================
# Scripts admin (Node)
# ===========================================

# Path absoluto al service account JSON de admin (least-privilege).
# Recomendado: ~/.mtb-keys/mtb-admin-cli.json (fuera del repo).
MTB_ADMIN_SA=/path/to/your/mtb-admin-cli.json

# Contrato Polygon MTBGEMS (público, NO secreto).
MTBGEMS_CONTRACT=0x...

# ===========================================
# Pinning IPFS — Pinata + Filebase (failover)
# ===========================================

PINATA_API_KEY=
PINATA_API_SECRET=

FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=
